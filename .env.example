# Copy to .env and edit. Every setting is described in docs/DEPLOYMENT.md;
# "lanora-server help" lists them too.

# The first administrator. Sign in at https://<host>:8443/ and change the
# password. If LANORA_ADMIN_PASSWORD is left empty, a password is generated
# and printed once in the server log.
LANORA_ADMIN_USER=admin
LANORA_ADMIN_PASSWORD=

# Only needed when clients reach the relay at a different address or port
# than the API (port mapping, a separate public IP):
# LANORA_RELAY_PUBLIC=:8443

# Only when the server sits behind your own reverse proxy:
# LANORA_TRUSTED_PROXIES=172.16.0.0/12

# Caps the server's memory use (Go runtime soft limit); useful on small hosts.
# GOMEMLIMIT=400MiB
